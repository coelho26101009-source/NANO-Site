{
  "name": "nano-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:motion": "node scripts/verify-motion.mjs",
    "images:generate": "node scripts/generate-images.mjs",
    "verify:images": "node scripts/verify-images.mjs",
    "format": "prettier --write src scripts docs *.json *.ts *.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agent-browser": "^0.38.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
